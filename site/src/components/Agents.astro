---
import { agents } from '../data/content';
import SectionHead from './SectionHead.astro';
---

<section id="agents" class="section" aria-labelledby="agents-title">
  <SectionHead id="agents-title" eyebrow="supported agents" title="One command. Every agent.">
    <p class="section-lead">Claude Code is supported today. The rest are on the way.</p>
  </SectionHead>
  <div class="agent-grid stagger">
    {
      agents.map((agent) => (
        <div class:list={['card', 'agent', { 'agent--active': agent.available }]}>
          <div class="agent-head">
            <h3>{agent.name}</h3>
            <span class:list={['status', { 'status--ok': agent.available }]}>
              {agent.available ? 'Available' : 'Coming soon'}
            </span>
          </div>
          <p set:html={agent.detail} />
        </div>
      ))
    }
  </div>
</section>
