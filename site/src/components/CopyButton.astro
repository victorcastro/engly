---
interface Props {
  text: string;
  label?: string;
  location: string;
}

const { text, label, location } = Astro.props;
---

<button
  type="button"
  class="chip"
  data-copy={text}
  data-track="copy_command"
  data-track-command={text}
  data-track-location={location}
  aria-label={label}>Copy</button
>
