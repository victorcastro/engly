---
import { cliCommands } from '../data/content';
import CopyButton from './CopyButton.astro';
import SectionHead from './SectionHead.astro';

const labelOf = (cmd: string) => cmd.replace(' <option> <value>', '');
---

<section id="docs" class="section" aria-labelledby="docs-title">
  <SectionHead id="docs-title" eyebrow="cli reference" title="Commands" />
  <div class="docs-grid">
    <div class="tablist cmd-list" role="tablist" aria-orientation="vertical" aria-label="CLI commands" data-tabs>
      {
        cliCommands.map((command, index) => (
          <button
            type="button"
            role="tab"
            class="tab cmd-tab"
            id={`cli-tab-${index}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`cli-panel-${index}`}
            tabindex={index === 0 ? 0 : -1}
          >
            <span>{labelOf(command.cmd)}</span>
            <span class="cmd-tag">{command.soon ? 'Coming soon' : ''}</span>
          </button>
        ))
      }
    </div>
    {
      cliCommands.map((command, index) => (
        <div
          class="cmd-panel"
          role="tabpanel"
          id={`cli-panel-${index}`}
          aria-labelledby={`cli-tab-${index}`}
          tabindex="0"
          hidden={index !== 0}
        >
          <div class="cmd-box cmd-box--lg">
            <span class="t-acc">$</span>
            <code>{command.cmd}</code>
            <CopyButton text={command.cmd} label={`Copy ${command.cmd}`} />
          </div>
          <p class="cmd-desc">{command.desc}</p>
          {command.opts.length > 0 && (
            <div class="opts">
              {command.opts.map((opt) => (
                <div class="opt">
                  <code>{opt.flag}</code>
                  <span>{opt.desc}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>
