---
import { configJson, configPreview, settingsRows } from '../data/content';
import CopyButton from './CopyButton.astro';
import SectionHead from './SectionHead.astro';
---

<section class="section" aria-labelledby="settings-title">
  <SectionHead id="settings-title" eyebrow="settings" title="One small config file">
    <p class="section-lead">Stored in <code>.engly/config.json</code> at the root of your project.</p>
  </SectionHead>
  <div class="settings-grid">
    <div class="table-wrap">
      <table class="settings-table">
        <thead>
          <tr>
            <th scope="col">Key</th>
            <th scope="col">Values</th>
            <th scope="col">Default</th>
          </tr>
        </thead>
        <tbody>
          {
            settingsRows.map((row) => (
              <tr>
                <td>{row.key}</td>
                <td>{row.values}</td>
                <td>{row.fallback}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="window">
      <div class="window-bar window-bar--code">
        .engly/config.json<CopyButton text={configJson} label="Copy config" />
      </div>
      <pre class="code">{'{'}{'\n'}{configPreview.map((row, index) => (<>{'  '}<span class="t-acc">"{row.key}"</span>: <span class={`t-${row.tone}`}>{row.value}</span>{index < configPreview.length - 1 ? ',' : ''}{'\n'}</>))}{'}'}</pre>
    </div>
  </div>
</section>
