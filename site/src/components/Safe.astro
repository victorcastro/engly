---
import { agentBlock, safeGuarantees } from '../data/content';
import CopyButton from './CopyButton.astro';
---

<section class="section" aria-labelledby="safe-title">
  <div class="safe-grid">
    <div class="safe-copy">
      <span class="eyebrow">// your files are safe</span>
      <h2 id="safe-title" class="section-title">Engly adds a little. It touches nothing else.</h2>
      <p class="section-lead">
        It only adds <code>.engly/</code>, the skills <code>engly-on</code>, <code>engly-off</code> and <code>engly-review</code>,
        and one marked block in your agent file.
      </p>
      <div class="window window--compact">
        <div class="window-bar window-bar--code">
          CLAUDE.md<CopyButton text={agentBlock} label="Copy agent block" />
        </div>
        <pre class="code"><span class="t-mut">&lt;!-- engly:start --&gt;</span>{'\n'}<span class="t-acc">@.engly/engly.md</span>{'\n'}<span class="t-mut">&lt;!-- engly:end --&gt;</span></pre>
      </div>
    </div>
    <ul class="check-list">
      {
        safeGuarantees.map((item) => (
          <li>
            <span aria-hidden="true" class="check">✓</span>
            <span set:html={item} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
