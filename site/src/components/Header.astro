---
import { navLinks, repoUrl } from '../data/content';
---

<header class="site-header">
  <nav class="nav" aria-label="Main">
    <a href="#top" class="brand"><span aria-hidden="true">✨</span>Engly</a>
    <div class="nav-links">
      {
        navLinks.map((link) => (
          <a href={link.href} data-track="nav_click" data-track-section={link.label} data-track-location="header">
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="nav-actions">
      <button type="button" class="icon-btn theme-btn" data-theme-toggle aria-label="Switch to light theme">
        <span class="theme-face" aria-hidden="true"><span class="i-sun">☀</span><span class="i-moon">☾</span></span>
        <span class="theme-next" aria-hidden="true"><span class="i-sun">☀</span><span class="i-moon">☾</span></span>
      </button>
      <a href={repoUrl} class="btn btn--outline nav-star" data-track="cta_click" data-track-cta="star_github" data-track-location="header"><span aria-hidden="true" class="star">★</span>Star on GitHub</a>
      <a href="#how" class="btn btn--primary" data-track="cta_click" data-track-cta="get_started" data-track-location="header">Get started</a>
      <button
        type="button"
        class="icon-btn menu-btn"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menu"
      >
        <span class="menu-icon menu-icon--open" aria-hidden="true">☰</span>
        <span class="menu-icon menu-icon--close" aria-hidden="true">✕</span>
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="mobile-menu" hidden>
    {
      navLinks.map((link) => (
        <a href={link.href} data-track="nav_click" data-track-section={link.label} data-track-location="mobile_menu">
          {link.label}
        </a>
      ))
    }
    <a href={repoUrl} data-track="cta_click" data-track-cta="star_github" data-track-location="mobile_menu"><span class="star">★</span> Star on GitHub</a>
  </div>
</header>
